{
  "entities": [
    {
      "name": "User",
      "table": "users",
      "primaryKey": "id(uuid)",
      "relations": ["bookings -> Booking[]"],
      "importantFields": ["email(unique)", "phone(unique)", "role", "isActive"]
    },
    {
      "name": "RefreshToken",
      "table": "refresh_tokens",
      "primaryKey": "id",
      "relations": ["user -> User"],
      "importantFields": ["userId", "token(unique)", "expiresAt", "isRevoked"]
    },
    {
      "name": "Genre",
      "table": "genres",
      "primaryKey": "id",
      "relations": ["movies <-> Movie[]"],
      "importantFields": ["name(unique)", "slug(unique)"]
    },
    {
      "name": "Movie",
      "table": "movies",
      "primaryKey": "id",
      "relations": ["genres <-> Genre[]", "showtimes -> Showtime[]"],
      "importantFields": ["slug(unique, nullable)", "title", "ageRating", "status", "releaseDate", "endDate"]
    },
    {
      "name": "Room",
      "table": "rooms",
      "primaryKey": "id",
      "relations": ["showtimes -> Showtime[]", "seats -> Seat[]"],
      "importantFields": ["name"]
    },
    {
      "name": "Seat",
      "table": "seats",
      "primaryKey": "id",
      "relations": ["room -> Room", "bookingSeats -> BookingSeat[]"],
      "importantFields": ["roomId", "seatKey", "rowLabel", "seatNumber", "seatType", "isActive"]
    },
    {
      "name": "Showtime",
      "table": "showtimes",
      "primaryKey": "id",
      "relations": ["movie -> Movie", "room -> Room", "bookings -> Booking[]"],
      "importantFields": ["movieId", "roomId", "startTime", "endTime"]
    },
    {
      "name": "Booking",
      "table": "bookings",
      "primaryKey": "id",
      "relations": ["user -> User", "showtime -> Showtime", "bookingSeats -> BookingSeat[]"],
      "importantFields": ["ticketCount", "totalPrice", "paymentMethod", "status"]
    },
    {
      "name": "BookingSeat",
      "table": "booking_seats",
      "primaryKey": "id",
      "relations": ["booking -> Booking", "seat -> Seat"],
      "importantFields": ["bookingId", "seatId", "seatKey", "price"]
    },
    {
      "name": "Promotion",
      "table": "promotions",
      "primaryKey": "id",
      "importantFields": ["title", "discountPercent", "promotionType", "startDate", "endDate", "isActive"]
    }
  ]
}