# App Settings
PORT=your_backend_port_here
FRONTEND_URL=your_frontend_url_here
NODE_ENV=development # options: development, production, test

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cinevora
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_ROOT_PASSWORD=your_db_root_password_here

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT Configuration
# Generate a secure string, e.g., using `openssl rand -base64 32`
JWT_ACCESS_TOKEN=your_jwt_access_secret_key
JWT_REFRESH_TOKEN=your_jwt_refresh_secret_key

# Google reCAPTCHA (Optional)
# Get keys at: https://www.google.com/recaptcha/admin
ENABLE_RECAPTCHA=false
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# MoMo Payment Configuration
# Get test keys at: https://business.momo.vn/
# If using MoMo sandbox environment, use the following endpoint:
MOMO_ACCESS_KEY=F8BBA842ECF85
MOMO_SECRET_KEY=K951B6PE1waDMi640xX08PD3vg6EkVlz

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ORDER_INFO=Payment via MoMo

# Redirect URL after payment
MOMO_REDIRECT_URL=http://<your-frontend-url>/payment/result

# Webhook/IPN URL for MoMo (Must be a public URL, use ngrok for local testing)
MOMO_IPN_URL=https://<your-public-domain>/payments/momo/callback

# MoMo Default Settings
MOMO_REQUEST_TYPE=payWithMethod
MOMO_EXTRA_DATA=
MOMO_ORDER_GROUP_ID=
MOMO_AUTO_CAPTURE=true
MOMO_LANG=vi

# MoMo API Endpoints (Use sandbox or production URLs)
MOMO_CREATE_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_PARTNER_NAME=Test
MOMO_STORE_ID=MomoTestStore